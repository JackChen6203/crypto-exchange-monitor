[Unit]
Description=加密貨幣交易所監控系統
Documentation=file:///opt/crypto-monitor/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=crypto-monitor
Group=crypto-monitor
WorkingDirectory=/opt/crypto-monitor
ExecStart=/usr/bin/java -Xmx512m -Xms256m -jar crypto-exchange-monitor-1.0-SNAPSHOT-jar-with-dependencies.jar
ExecReload=/bin/kill -HUP $MAINPID

# 重啟策略
Restart=always
RestartSec=10
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30

# 安全設置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crypto-monitor/logs
ReadOnlyPaths=/opt/crypto-monitor

# 資源限制
LimitNOFILE=65536
LimitNPROC=4096

# 環境變量
Environment=JAVA_HOME=/usr/lib/jvm/java-17-openjdk
Environment=LANG=zh_TW.UTF-8
Environment=TZ=Asia/Taipei

# 日誌設置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto-monitor

[Install]
WantedBy=multi-user.target 